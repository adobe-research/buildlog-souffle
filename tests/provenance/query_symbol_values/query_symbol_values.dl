// This code tests that query prints symbol solutions as string literals, so
// symbols containing separators, quotes or spaces are not ambiguous.

.pragma "provenance" "explain"

.decl pair(x: symbol, y: symbol)
.output pair
pair("a, y = b", "c").
pair("a", "b, y = c").
pair("say \"hi\"", "").
pair(" spaced ", "back\\slash").
