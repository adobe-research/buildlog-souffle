// This code tests that explain, explainnegation and query read and print
// symbols with escape sequences as Datalog string literals.

.pragma "provenance" "explain"

.type Pair = [key: symbol, value: symbol]

.decl a(x: symbol, p: Pair)
a("he said \"hi\"", ["k\\v", "q\"x"]).
a("back\\slash, (tab\t)", ["k", "v"]).
a("back\\slash", ["k", "v"]).

.decl b(x: symbol, p: Pair)
.output b
b(x, p) :- a(x, p).

.decl c(x: symbol)
.output c
c(x) :- a(x, p), a(y, p), x != y, y = "back\\slash".
