// This code tests that JSON proofs are valid JSON when symbols contain
// backslashes, quotes, semicolons and control characters.

.pragma "provenance" "explain"

.decl a(k: number, x: symbol)
a(1, "back\\slash; \"quoted\"").

.decl b(k: number, x: symbol)
.output b
b(k, x) :- a(k, x), x != "semi;colon\ttab\r\a".
