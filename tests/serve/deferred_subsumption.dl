// Subsumption erases from output relations, which are then consumed by later strata.
.decl edge(x:number, y:number)
.input edge
.decl dist(x:number, d:number) btree_delete
.output dist
dist(x, 0) :- x = 1.
dist(y, d+1) :- dist(x, d), edge(x, y), d < 10.
dist(x, d1) <= dist(x, d2) :- d2 <= d1.
.decl far(x:number)
.output far
far(x) :- dist(x, d), d >= 2.
.decl cnt(n:number)
.output cnt
cnt(n) :- n = count : far(_).
.decl small(x:number, d:number) btree_delete
.output small
small(1, 5).
small(1, 3).
small(2, 4).
small(x, d1) <= small(x, d2) :- d2 <= d1.
